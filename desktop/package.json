{
  "name": "douyin-desktop",
  "productName": "Vulcan抖音控制台",
  "version": "1.1.1",
  "description": "Vulcan 抖音控制台桌面版",
  "author": "ZZY",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "build": "vite build",
    "prepare:backend": "node scripts/prepare-backend.js",
    "dist": "npm run build && npm run prepare:backend && electron-builder --win nsis --x64",
    "dev": "vite --host 127.0.0.1",
    "electron": "cmd /c \"set ELECTRON_RUN_AS_NODE=& electron .\"",
    "smoke:packaged": "node scripts/packaged-smoke.js",
    "start": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5174 && npm run electron\"",
    "test:profiles": "node electron/profile-smoke.js"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-test-renderer": "19.2.7",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zzy.vulcan.douyin",
    "productName": "Vulcan抖音控制台",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "installer-final-package"
    },
    "files": [
      "electron/**/*",
      "package.json",
      {
        "from": "renderer/src/assets/tongzhouxing-logo.png",
        "to": "renderer/src/assets/tongzhouxing-logo.png"
      }
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "executableName": "Vulcan",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vulcan抖音控制台"
    }
  }
}
