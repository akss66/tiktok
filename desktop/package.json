{
  "name": "douyin-desktop",
  "productName": "Vulcan抖音控制台",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "cmd /c \"set ELECTRON_RUN_AS_NODE=& electron .\"",
    "start": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "test:profiles": "node electron/profile-smoke.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1",
    "ws": "^8.21.0"
  }
}
